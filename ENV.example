# Copy to `.env.local` (never commit secrets)

# Public site URL (no trailing slash) — canonicals & sitemap
NEXT_PUBLIC_SITE_URL=https://golaxindiapvtltd.in

# Google Search Console HTML tag content (optional)
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Calendly / Cal.com URL (optional)
NEXT_PUBLIC_BOOKING_URL=

# Resend — required for /api/leads
RESEND_API_KEY=
LEAD_FROM_EMAIL=Golax India Website <onboarding@resend.dev>
LEAD_TO_EMAIL=contact@golaxindia.com
